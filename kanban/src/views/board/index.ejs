<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aula 03 - <%= board.name %></title>
    <!-- CDN do Tailwind: escolha deliberada para manter o foco desta aula em
         modularidade de backend, não em pipeline de build de CSS (isso é
         Aula 15). Em produção, o caminho normal seria o Tailwind CLI/PostCSS
         gerando um arquivo estático. -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <header class="bg-slate-900 text-white px-6 py-4">
      <h1 class="text-xl font-semibold"><%= board.name %></h1>
      <p class="text-slate-300 text-sm">
        Quadro Kanban
      </p>
    </header>

    <main class="p-6 flex gap-4 overflow-x-auto items-start">
      <% board.columns.forEach((column) => { %>
        <section class="bg-white rounded-lg shadow w-72 flex-shrink-0">
          <header class="px-4 py-3 border-b flex items-center justify-between">
            <h2 class="font-medium text-slate-700"><%= column.name %></h2>
            <span
              class="text-xs px-2 py-1 rounded-full <%= column.isOverWipLimit ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-500' %>"
            ><%= column.cards.length %><%= column.wipLimit !== null ? '/' + column.wipLimit : '' %></span>
          </header>

          <ul class="p-3 space-y-2 min-h-[80px]">
            <% if (column.cards.length === 0) { %>
              <li class="text-sm text-slate-400 italic">Sem cartões</li>
            <% } %>
            <% column.cards.forEach((card) => { %>
              <li class="border rounded-md p-3 shadow-sm">
                <p class="text-sm font-medium text-slate-800"><%= card.title %></p>
                <% if (card.description) { %>
                  <p class="text-xs text-slate-500 mt-1"><%= card.description %></p>
                <% } %>
                <span class="inline-block mt-2 text-[11px] px-2 py-0.5 rounded-full <%= card.priorityBadgeClass %>">
                  <%= card.priority %>
                </span>
                <form method="post" action="/cards/<%= card.id %>/move" class="mt-3 flex gap-2">
                  <select name="columnId" class="min-w-0 flex-1 border rounded px-2 py-1 text-xs">
                    <% board.columns.forEach((destination) => { %>
                      <option value="<%= destination.id %>" <%= destination.id === column.id ? 'selected' : '' %>><%= destination.name %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="text-xs bg-yellow-400 text-slate-900 rounded px-2 py-1 hover:bg-yellow-500">Mover</button>
                </form>
                <form method="post" action="/cards/<%= card.id %>/update" class="mt-2 flex flex-col gap-2">
                  <input type="text" name="title" value="<%= card.title %>" required minlength="3" maxlength="120" class="w-full border rounded px-2 py-1 text-xs" />
                  <input type="text" name="description" value="<%= card.description %>" placeholder="Descrição" class="w-full border rounded px-2 py-1 text-xs" />
                  <div class="flex gap-2">
                    <select name="priority" class="min-w-0 flex-1 border rounded px-2 py-1 text-xs">
                      <% ['baixa', 'média', 'alta'].forEach((priority) => { %>
                        <option value="<%= priority %>" <%= priority === card.priority ? 'selected' : '' %>><%= priority %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="text-xs bg-green-700 text-white rounded px-2 py-1 hover:bg-green-800">Salvar</button>
                  </div>
                </form>
                <form method="post" action="/cards/<%= card.id %>/delete" class="mt-2">
                  <button type="submit" class="text-xs bg-red-700 text-white rounded px-2 py-1 hover:bg-red-800">Excluir</button>
                </form>
              </li>
            <% }) %>
          </ul>

          <form method="post" action="/cards" class="p-3 border-t flex flex-col gap-2">
            <input type="hidden" name="columnId" value="<%= column.id %>" />
            <input
              type="text"
              name="title"
              placeholder="Novo cartão..."
              required minlength="3" maxlength="120"
              class="border rounded px-2 py-1 text-sm"
            />
            <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1 hover:bg-slate-700">
              Adicionar cartão
            </button>
          </form>
        </section>
      <% }) %>
      <section class="bg-white rounded-lg shadow w-72 flex-shrink-0">
        <h2 class="px-4 py-3 border-b font-medium text-slate-700">Nova coluna</h2>
        <form method="post" action="/columns" class="p-3 flex flex-col gap-2">
          <input type="text" name="name" placeholder="Nome da coluna" required minlength="2" maxlength="40" class="border rounded px-2 py-1 text-sm" />
          <input type="number" name="wipLimit" placeholder="Limite WIP (opcional)" min="0" step="1" class="border rounded px-2 py-1 text-sm" />
          <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1 hover:bg-slate-700">Criar coluna</button>
        </form>
      </section>
    </main>
  </body>
</html>
